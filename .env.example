# ClaimLens Environment Configuration Template
# Copy this file to .env and configure your keys as needed.

# ==============================================================================
# 1. Google Gemini API (Recommended Default)
# Get a free key at: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=

# Default VLM (Vision) Model: gemini-3.6-flash, gemini-3.7-flash, gemini-2.0-flash
GEMINI_VLM_MODEL=gemini-3.6-flash

# Default LLM (Reasoning & Q&A) Model
LLM_MODEL=gemini-3.6-flash
LLM_PROVIDER=gemini

# ==============================================================================
# 2. Vision Language Model Backend
# Options: gemini, openrouter, openai, ollama, rest, stub
# ==============================================================================
VLM_BACKEND=gemini

# ==============================================================================
# 3. Optional Multi-Provider Backends
# ==============================================================================
# OpenRouter (Access to Llama 3.2 Vision, Qwen 2.5 VL, Claude, etc.)
OPENROUTER_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Local Ollama Endpoint (100% offline, free)
OLLAMA_BASE_URL=http://localhost:11434

# Local Custom REST Model Endpoint (FastAPI / Triton)
VLM_REST_ENDPOINT=http://localhost:8000/assess

# ==============================================================================
# 4. RAG & Knowledge Base Configuration
# ==============================================================================
ENABLE_RAG=true
RAG_PERSONA=Adjuster
